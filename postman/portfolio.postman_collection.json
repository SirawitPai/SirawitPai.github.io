{
  "info": {
    "_postman_id": "2bc95206-9f1b-4c0f-a84e-0af1ac151784",
    "name": "Sirawit Portfolio — API tests",
    "description": "Smoke tests for the portfolio site and the public GitHub API it links to. Run in Postman, or from the command line with `npm run test:api` (local) / `npm run test:api:prod` (live site).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Portfolio site",
      "item": [
        {
          "name": "Home page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));",
                  "pm.test('shows the owner name and title', () => {",
                  "  const html = pm.response.text();",
                  "  pm.expect(html).to.include('Sirawit Boonthong');",
                  "  pm.expect(html).to.include('<title>');",
                  "});",
                  "pm.test('loads utils, translations and page script', () => {",
                  "  const html = pm.response.text();",
                  "  ['assets/js/utils.js', 'assets/js/i18n-data.js', 'assets/js/portfolio.js'].forEach((src) => pm.expect(html).to.include(src));",
                  "});",
                  "pm.test('responds in under 2 seconds', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "The portfolio home page loads with the right content."
          }
        },
        {
          "name": "Translations file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('is served as JavaScript', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/javascript/));",
                  "pm.test('contains the translation table with Thai text', () => {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body).to.include('I18N_TRANSLATIONS');",
                  "  pm.expect(body).to.match(/[\\u0E00-\\u0E7F]/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/assets/js/i18n-data.js",
            "description": ""
          }
        },
