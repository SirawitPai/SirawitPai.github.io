    {
      "name": "GitHub API",
      "item": [
        {
          "name": "GitHub profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const user = pm.response.json();",
                  "pm.test('login matches the portfolio owner', () => pm.expect(user.login.toLowerCase()).to.eql(pm.variables.get('githubUser').toLowerCase()));",
                  "pm.test('has a public repo count', () => pm.expect(user.public_repos).to.be.a('number'));",
                  "pm.collectionVariables.set('publicRepos', user.public_repos);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "User-Agent",
                "value": "sirawit-portfolio-tests"
              }
            ],
            "url": "{{githubApi}}/users/{{githubUser}}",
            "description": "The GitHub account linked from the portfolio exists and belongs to the owner."
          }
        },
        {
          "name": "GitHub repositories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const repos = pm.response.json();",
                  "pm.test('returns a list of repositories', () => pm.expect(repos).to.be.an('array'));",
                  "pm.test('every repository has a name and a link', () => {",
                  "  repos.forEach((repo) => {",
                  "    pm.expect(repo.name).to.be.a('string');",
                  "    pm.expect(repo.html_url).to.include('github.com');",
                  "  });",
                  "});",
                  "pm.test('count matches the profile', () => {",
                  "  const expected = Number(pm.collectionVariables.get('publicRepos'));",
                  "  if (expected <= 100) pm.expect(repos.length).to.eql(expected);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "User-Agent",
                "value": "sirawit-portfolio-tests"
              }
            ],
            "url": "{{githubApi}}/users/{{githubUser}}/repos?per_page=100",
            "description": ""
          }
        }
      ]
    }
  ],
